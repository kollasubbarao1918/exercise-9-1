import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;

public class DatabaseConnectionExample {

    // 1. Define database connection details
    private static final String URL = "jdbc:mysql://localhost:3306/your_database_name";
    private static final String USER = "your_username";
    private static final String PASSWORD = "your_password";

    public static void main(String[] args) {
        // 2. Define the SQL query
        String query = "SELECT id, name, email FROM users";

        System.out.println("Connecting to database...");

        // 3. Establish connection and execute query using try-with-resources
        try (Connection connection = DriverManager.getConnection(URL, USER, PASSWORD);
             Statement statement = connection.createStatement();
             ResultSet resultSet = statement.executeQuery(query)) {

            System.out.println("Connection established successfully!");

            // 4. Process the results
            while (resultSet.next()) {
                int id = resultSet.getInt("id");
                String name = resultSet.getString("name");
                String email = resultSet.getString("email");

                System.out.println("ID: " + id + ", Name: " + name + ", Email: " + email);
            }

        } catch (SQLException e) {
            System.err.println("Database connection or execution failed!");
            e.printStackTrace();
        }
        // Resources (Connection, Statement, ResultSet) are automatically closed here.
    }
}
